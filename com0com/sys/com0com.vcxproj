    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Label="Configuration"
      Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>False</UseDebugLibraries>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- InfVerif.dll (x86) is not included in all WDK installs. -->
    <SkipPackageVerification>true</SkipPackageVerification>
    <!-- Suppress deprecation warnings for legacy pool allocation APIs.
         ExAllocatePoolWithTag/ExAllocatePoolWithQuotaTag are deprecated in
         favor of ExAllocatePool2, but the newer API requires WDK 10.0.26100+
         and structural changes to every call site. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Disable driver signing during development builds.
         Signing requires a code-signing certificate configured in the project.
         The driver will be test-signed separately for installation. -->
    <SignMode>Off</SignMode>
    <DriverSign_Type>0</DriverSign_Type>
  </PropertyGroup>
  <ItemDefinitionGroup>
